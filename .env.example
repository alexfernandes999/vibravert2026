# Postgres do Supabase — a loja vive no schema "vibravert"
# Pooler de transações (6543): usado pela aplicação em runtime
DATABASE_URL="postgresql://USUARIO:SENHA@HOST:6543/postgres?pgbouncer=true&schema=vibravert"
# Conexão direta (5432): obrigatória para `prisma migrate`
DIRECT_URL="postgresql://postgres:SENHA@HOST:5432/postgres?schema=vibravert"

NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Mercado Pago — checkout transparente
MP_ACCESS_TOKEN=""
NEXT_PUBLIC_MP_PUBLIC_KEY=""
MP_WEBHOOK_SECRET=""

NEXT_PUBLIC_URL="https://lojavibravert.com.br"

# Painel de administração
ADMIN_SENHA=""
ADMIN_SEGREDO=""

# Correios — API CWS, exige contrato. O web service antigo foi desativado.
CORREIOS_USUARIO=""
CORREIOS_CODIGO_ACESSO=""
CORREIOS_CARTAO_POSTAGEM=""
CORREIOS_CEP_ORIGEM=""
CORREIOS_SERVICO_PAC=""
CORREIOS_SERVICO_SEDEX=""

# E-mails transacionais (Resend). O remetente precisa de SPF e DKIM no domínio —
# somar aos registros da Locaweb, nunca substituir, ou o e-mail da empresa cai.
RESEND_API_KEY=""
EMAIL_REMETENTE="Vibra Vert <pedidos@vibravert.com.br>"

# ── Assistência técnica (portal de garantia) ──────────────────────────────
# API da Claude: Sonnet 5.5 nas fotos, Haiku 5.5 nos textos. Fixe um limite
# mensal de gasto no console da Anthropic.
ANTHROPIC_API_KEY=""
# Assina o link da página do protocolo. Gere um valor longo e aleatório.
ASSISTENCIA_SEGREDO=""
# "1" libera as aprovações automáticas sem conferência. Vazio = o operador
# confere também as aprovações (recomendado nas primeiras semanas).
ASSISTENCIA_LIBERACAO_AUTOMATICA=""
# Ids de loja do Bling → canal, para confirmar a origem da NF.
# Ex.: {"203456789":"ml","203456790":"shopee"}
BLING_LOJAS="{}"
# Conector MCP da Claude: URL com o papel restrito claude_conector
# (ALTER ROLE claude_conector LOGIN PASSWORD '...') e o token do conector.
DATABASE_URL_CLAUDE=""
MCP_TOKEN_CLAUDE=""
