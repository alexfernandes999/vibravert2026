# Postgres do Supabase — a loja vive no schema "vibravert"
# Pooler de transações (6543): usado pela aplicação em runtime
DATABASE_URL="postgresql://USUARIO:SENHA@HOST:6543/postgres?pgbouncer=true&schema=vibravert"
# Conexão direta (5432): obrigatória para `prisma migrate`
DIRECT_URL="postgresql://postgres:SENHA@HOST:5432/postgres?schema=vibravert"

NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Mercado Pago — checkout transparente
MP_ACCESS_TOKEN=""
NEXT_PUBLIC_MP_PUBLIC_KEY=""
MP_WEBHOOK_SECRET=""

NEXT_PUBLIC_URL="https://lojavibravert.com.br"

# Painel de administração
ADMIN_SENHA=""
ADMIN_SEGREDO=""
