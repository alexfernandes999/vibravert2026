// Loja oficial Vibra Vert / Rymer
// Convive com o projeto Multiplica no mesmo Postgres do Supabase, isolado
// no schema "vibravert" para que as tabelas nunca colidam.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")      // pooler (6543) — usado pela aplicação
  directUrl = env("DIRECT_URL")        // conexão direta (5432) — usada nas migrações
  schemas   = ["vibravert"]
}

// ─────────────────────────── catálogo ───────────────────────────

model Produto {
  id            String   @id @default(cuid())
  slug          String   @unique
  slugAntigo    String?  @unique          // linkText da VTEX — base do redirecionamento 301
  nome          String
  marca         String
  sku           String   @unique          // RefId do fabricante — vira o mpn no feed
  ean           String?                   // ausente em quase todo o catálogo próprio
  modelo        String?
  descricao     String   @default("")
  metaTitulo    String?
  metaDescricao String?
  preco         Decimal  @db.Decimal(10, 2)
  precoDe       Decimal? @db.Decimal(10, 2)
  ativo         Boolean  @default(true)
  destaque      Boolean  @default(false)
  criadoEm      DateTime @default(now())
  atualizadoEm  DateTime @updatedAt

  // Atributos de filtro, derivados das especificações no seed.
  // Ficam desnormalizados de propósito: a listagem filtra por faixa numérica
  // sem precisar varrer a tabela de especificações a cada consulta.
  vazaoMaxima   Int?     // litros por hora, na altura zero
  alturaMaxima  Int?     // metros de coluna d'água
  potenciaWatts Int?
  voltagem      String?  // "220V" | "110/127V" | "Bivolt"
  acompanhaBoia Boolean  @default(false)
  acompanhaKit  Boolean  @default(false)

  /// As quatro montagens da mesma bomba — só a bomba, + boia, + kit, + boia e
  /// kit — eram quatro produtos separados disputando a mesma busca no Google,
  /// cada um com uma fração das avaliações e dos links. Passam a ser versões
  /// de um mesmo produto: uma página forte no lugar de quatro fracas.
  /// A família agrupa por modelo e tensão, porque 220V e 110V são bombas
  /// diferentes de verdade, não uma escolha de acessório.
  familia       String?
  versao        Versao   @default(BOMBA)
  /// A versão canônica da família: é dela a URL que o Google indexa.
  principalDaFamilia Boolean @default(false)

  /// Diâmetro mínimo do poço, em polegadas. É o primeiro critério de escolha:
  /// uma bomba de 8" simplesmente não entra num poço de 6", por mais vazão
  /// que tenha. Não estava em nenhum produto do cadastro antigo.
  pocoPolegadas Int?
  /// Peça de borracha que envolve o corpo e permite trabalhar ajustada num
  /// poço de 6 polegadas sem bater nas paredes. É o que diferencia a Rymer
  /// 2500 da 2000 — a hidráulica das duas é idêntica.
  saiaProtecao  Boolean  @default(false)

  /// Decide o frete grátis. Todo o catálogo de hoje é bomba; peças entram
  /// depois e pagam frete.
  tipo TipoProduto @default(BOMBA)

  /// Peso e medidas da CAIXA despachada, não da bomba nua: os Correios cobram
  /// por peso cubado, e uma caixa maior que o produto muda o frete. Onde o
  /// cadastro não tinha o dado, ele é estimado a partir do corpo da bomba mais
  /// a folga da embalagem — e `medidasEstimadas` diz quando isso aconteceu,
  /// para não passar por medição de verdade.
  pesoGramas       Int?
  alturaCm         Int?
  larguraCm        Int?
  comprimentoCm    Int?
  medidasEstimadas Boolean @default(false)

  /// Vazão em litros/hora a 0, 10, 20, 30, 40, 50, 60 e 65 m.c.a.
  /// Alimenta o seletor "qual bomba eu preciso" — a resposta deixa de ser
  /// achismo e passa a ser o número da instalação do cliente.
  curvaVazao    Int[]

  especificacoes Especificacao[]
  imagens        Imagem[]
  categorias     ProdutoCategoria[]
  estoque        Estoque?
  itensPedido    PedidoItem[]
  prateleiras    PrateleiraProduto[]

  @@index([marca])
  @@index([ativo, destaque])
  @@index([voltagem, vazaoMaxima])
  @@index([familia, versao])
  @@map("produtos")
  @@schema("vibravert")
}

/// Vazão, altura manométrica, voltagem, potência… Alimenta ao mesmo tempo a
/// ficha técnica, os filtros da listagem e os atributos do feed do Shopping.
model Especificacao {
  id           String   @id @default(cuid())
  produtoId    String
  nome         String                  // nome canônico, já normalizado
  nomeOriginal String?                 // como estava na VTEX — rastreabilidade da migração
  valor        String
  valorNumero  Decimal? @db.Decimal(10, 2)
  unidade      String?
  ordem        Int      @default(0)
  filtravel    Boolean  @default(false)

  produto Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  @@unique([produtoId, nome])
  @@index([nome, valor])
  @@map("especificacoes")
  @@schema("vibravert")
}

model Imagem {
  id        String  @id @default(cuid())
  produtoId String
  url       String
  alt       String
  ordem     Int     @default(0)
  principal Boolean @default(false)

  produto Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  @@index([produtoId, ordem])
  @@map("imagens")
  @@schema("vibravert")
}

model Categoria {
  id            String  @id @default(cuid())
  slug          String  @unique
  nome          String
  descricao     String?
  metaTitulo    String?
  metaDescricao String?
  ordem         Int     @default(0)
  ativa         Boolean @default(true)
  paiId         String?

  pai      Categoria?         @relation("Arvore", fields: [paiId], references: [id])
  filhas   Categoria[]        @relation("Arvore")
  produtos ProdutoCategoria[]

  @@map("categorias")
  @@schema("vibravert")
}

model ProdutoCategoria {
  produtoId   String
  categoriaId String

  produto   Produto   @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  categoria Categoria @relation(fields: [categoriaId], references: [id], onDelete: Cascade)

  @@id([produtoId, categoriaId])
  @@map("produtos_categorias")
  @@schema("vibravert")
}

model Estoque {
  produtoId    String   @id
  quantidade   Int      @default(0)
  minimo       Int      @default(5)
  atualizadoEm DateTime @updatedAt

  produto Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  @@map("estoques")
  @@schema("vibravert")
}

// ─────────────────────────── vitrine editável ───────────────────────────

/// As quatro montagens em que a mesma bomba é vendida.
enum Versao {
  BOMBA      // só a bomba, para quem já tem a instalação e vai substituir
  BOIA       // + boia de nível: liga e desliga sozinha, não roda seca
  KIT        // + kit de manutenção: peças de desgaste para quem mora longe
  BOIA_KIT   // instalação completa

  @@schema("vibravert")
}

/// Vídeo do canal oficial. O tipo separa o que já existe do que ainda não:
/// os vídeos de produto estão gravados; os de defeito ("a bomba não puxa
/// água") são a maior oportunidade de conteúdo da categoria e ainda precisam
/// ser produzidos — quem conserta é a fábrica, então o técnico da bancada é
/// quem tem o roteiro.
/// Etapas do funil. Sem registrar cada passo não há como saber onde a venda
/// se perde — e "o site não converte" vira opinião em vez de número.
enum EtapaFunil {
  VISITA
  PRODUTO
  CARRINHO
  CHECKOUT
  PEDIDO

  @@schema("vibravert")
}

/// Um registro por passo, por sessão. A sessão é um identificador anônimo em
/// cookie: não guarda nada que identifique a pessoa, e serve só para ligar o
/// mesmo visitante entre as etapas.
model Evento {
  id       String     @id @default(cuid())
  sessao   String
  etapa    EtapaFunil
  origem   String?    // "google / orgânico", "instagram / social", "direto"…
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  uf       String?    @db.Char(2)
  criadoEm DateTime   @default(now())

  @@index([etapa, criadoEm])
  @@index([sessao])
  @@map("eventos")
  @@schema("vibravert")
}

enum TipoVideo {
  PRODUTO
  PROBLEMA

  @@schema("vibravert")
}

model Video {
  id        String    @id @default(cuid())
  youtubeId String    @unique
  titulo    String
  resumo    String?
  tipo      TipoVideo @default(PRODUTO)
  /// Família de produto a que se refere, quando é vídeo de produto.
  familia   String?
  ordem     Int       @default(0)
  ativo     Boolean   @default(true)

  @@index([tipo, ativo, ordem])
  @@index([familia])
  @@map("videos")
  @@schema("vibravert")
}

enum BannerPosicao {
  PRINCIPAL
  FAIXA_DUPLA
  FAIXA_MEIO
  TARJA_TOPO

  @@schema("vibravert")
}

/// Trocar banner não pode exigir programador. Data de início/fim permite
/// deixar a promoção agendada e ela sobe sozinha.
model Banner {
  id            String        @id @default(cuid())
  titulo        String
  posicao       BannerPosicao @default(PRINCIPAL)
  imagemDesktop String?
  imagemMobile  String?
  alt           String                          // obrigatório na interface: acessibilidade e SEO
  link          String?
  ordem         Int           @default(0)
  ativo         Boolean       @default(false)
  inicioEm      DateTime?
  fimEm         DateTime?
  criadoEm      DateTime      @default(now())

  @@index([posicao, ativo, ordem])
  @@map("banners")
  @@schema("vibravert")
}

model Prateleira {
  id     String  @id @default(cuid())
  slug   String  @unique
  titulo String
  ordem  Int     @default(0)
  ativa  Boolean @default(true)

  produtos PrateleiraProduto[]

  @@map("prateleiras")
  @@schema("vibravert")
}

model PrateleiraProduto {
  prateleiraId String
  produtoId    String
  ordem        Int    @default(0)

  prateleira Prateleira @relation(fields: [prateleiraId], references: [id], onDelete: Cascade)
  produto    Produto    @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  @@id([prateleiraId, produtoId])
  @@map("prateleiras_produtos")
  @@schema("vibravert")
}

model Pagina {
  id            String   @id @default(cuid())
  slug          String   @unique
  titulo        String
  conteudo      String   @default("")
  metaTitulo    String?
  metaDescricao String?
  publicada     Boolean  @default(false)
  atualizadoEm  DateTime @updatedAt

  @@map("paginas")
  @@schema("vibravert")
}

/// Mapa de redirecionamento. Mesmo nascendo em endereço próprio, links antigos
/// circulam em anúncios, catálogos impressos e no WhatsApp dos revendedores.
model Redirecionamento {
  id       String   @id @default(cuid())
  de       String   @unique
  para     String
  tipo     Int      @default(301)
  acessos  Int      @default(0)
  criadoEm DateTime @default(now())

  @@map("redirecionamentos")
  @@schema("vibravert")
}

// ─────────────────────────── vendas ───────────────────────────

enum PedidoStatus {
  AGUARDANDO_PAGAMENTO
  PAGO
  SEPARANDO
  ENVIADO
  ENTREGUE
  CANCELADO
  REEMBOLSADO

  @@schema("vibravert")
}

enum MetodoPagamento {
  PIX
  CARTAO_CREDITO
  BOLETO

  @@schema("vibravert")
}

model Cliente {
  id        String   @id @default(cuid())
  email     String   @unique
  nome      String
  cpfCnpj   String?
  telefone  String?
  criadoEm  DateTime @default(now())

  enderecos Endereco[]
  pedidos   Pedido[]

  @@map("clientes")
  @@schema("vibravert")
}

model Endereco {
  id          String  @id @default(cuid())
  clienteId   String
  cep         String
  logradouro  String
  numero      String
  complemento String?
  bairro      String
  cidade      String
  uf          String  @db.Char(2)
  principal   Boolean @default(false)

  cliente Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  pedidos Pedido[]

  @@map("enderecos")
  @@schema("vibravert")
}

model Pedido {
  id         String          @id @default(cuid())
  numero     Int             @unique @default(autoincrement())
  clienteId  String
  enderecoId String
  status     PedidoStatus    @default(AGUARDANDO_PAGAMENTO)
  metodo     MetodoPagamento
  subtotal   Decimal         @db.Decimal(10, 2)
  frete      Decimal         @db.Decimal(10, 2) @default(0)
  desconto   Decimal         @db.Decimal(10, 2) @default(0)
  total      Decimal         @db.Decimal(10, 2)
  parcelas   Int             @default(1)

  // Mercado Pago — o webhook é a fonte da verdade do pagamento, nunca o retorno do navegador
  mpPagamentoId String?  @unique
  mpStatus      String?
  mpDetalhe     String?
  pagoEm        DateTime?

  /// De onde veio a venda. Copiado da sessão no fechamento: sem isso não se
  /// sabe quanto cada canal fatura, só quanto cada canal visita.
  origem      String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?

  /// Recuperação de pedido parado.
  ///
  /// Conta quantos lembretes já foram enviados e quando foi o último. Sem
  /// isso, a mesma pessoa recebe cobrança toda vez que alguém abre a tela ·
  /// e insistir é o que transforma recuperação em spam.
  lembretes  Int       @default(0)
  lembreteEm DateTime?

  /// Qual serviço o cliente escolheu e pagou. Sem isto a expedição não sabe
  /// se posta em PAC ou SEDEX, e postar no errado é cobrar um e entregar
  /// outro — prejuízo se for para cima, reclamação se for para baixo.
  freteServico String?
  fretePrazo   Int?

  /// Etiqueta comprada no SuperFrete. Guarda o id do pedido lá e o link do PDF
  /// para reimprimir: a expedição perde etiqueta, e comprar de novo é pagar
  /// duas vezes pelo mesmo envio.
  etiquetaId  String?
  etiquetaUrl String?
  etiquetaEm  DateTime?

  rastreio     String?
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  cliente  Cliente      @relation(fields: [clienteId], references: [id])
  endereco Endereco     @relation(fields: [enderecoId], references: [id])
  itens    PedidoItem[]

  @@index([status, criadoEm])
  @@map("pedidos")
  @@schema("vibravert")
}

model PedidoItem {
  id            String  @id @default(cuid())
  pedidoId      String
  produtoId     String
  quantidade    Int
  precoUnitario Decimal @db.Decimal(10, 2)
  nomeProduto   String                       // congelado: o preço e o nome do dia da compra
  skuProduto    String

  pedido  Pedido  @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  produto Produto @relation(fields: [produtoId], references: [id])

  @@map("pedidos_itens")
  @@schema("vibravert")
}

/// Quem opera a loja.
///
/// Substitui a senha única compartilhada. Uma conta por pessoa resolve três
/// coisas que uma senha só não resolve: dá para saber quem mexeu no preço,
/// dá para tirar o acesso de uma pessoa sem trocar a senha de todo mundo, e
/// cada um tem o seu próprio segundo fator, no seu próprio celular.
model Usuario {
  id    String @id @default(cuid())
  login String @unique
  nome  String
  email String @unique

  /// scrypt com sal por usuário. Nunca a senha em texto.
  senhaHash String
  /// Segredo TOTP, um por pessoa. Perder o celular afeta só quem o perdeu.
  segredo2FA String?

  papel PapelUsuario @default(OPERADOR)
  ativo Boolean      @default(true)

  /// Se já viu o tour de boas-vindas. Fica no usuário, e não no navegador:
  /// quem troca de computador não devia ver tudo de novo.
  viuTour Boolean @default(false)

  ultimoAcesso DateTime?
  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt

  registros Registro[]

  @@schema("vibravert")
}

enum PapelUsuario {
  /// Mexe na loja: pedidos, estoque, produtos, banners. É o dia a dia.
  OPERADOR
  /// O dono. Tudo do operador, mais criar e desligar quem tem acesso.
  MASTER
  /// Quem cuida do sistema. Tudo do master, mais integrações e diagnóstico.
  DESENVOLVEDOR

  @@schema("vibravert")
}

/// Trilha de auditoria.
///
/// Preço trocado, pedido cancelado, produto desativado: sem registro, a
/// pergunta "quem fez isso" não tem resposta, e numa loja com mais de uma
/// pessoa essa pergunta sempre aparece.
model Registro {
  id        String   @id @default(cuid())
  usuarioId String
  acao      String
  alvo      String?
  detalhe   String?
  criadoEm  DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([criadoEm])
  @@schema("vibravert")
}

/// Pedido de troca de senha.
///
/// Guarda o hash do token, nunca o token. Assim um vazamento do banco não
/// entrega o acesso: quem lê a tabela vê um resumo que não serve para montar
/// o link de volta.
model RecuperacaoSenha {
  id        String    @id @default(cuid())
  usuarioId String
  tokenHash String    @unique
  expiraEm  DateTime
  usadoEm   DateTime?
  criadoEm  DateTime  @default(now())

  @@index([usuarioId, criadoEm])
  @@schema("vibravert")
}

/// O que o item é, para a regra de frete.
///
/// Bomba tem frete grátis sempre, sem valor mínimo. Peça, kit avulso e
/// acessório pagam frete calculado. Sem esta distinção, a promessa "frete
/// grátis em todas as bombas" ou não se cumpre, ou passa a valer para uma
/// ventosa de trinta reais — e aí o frete custa mais que o produto.
enum TipoProduto {
  BOMBA
  PECA
  KIT_AVULSO
  ACESSORIO

  @@schema("vibravert")
}

/// Cadastro de revenda.
///
/// O revendedor não digita nada que a Receita já sabe: informa o CNPJ e o
/// resto vem preenchido. Só confere e corrige o que precisar.
model Revendedor {
  id   String @id @default(cuid())
  cnpj String @unique

  razaoSocial  String
  nomeFantasia String?
  inscricaoEstadual String?
  cnae         String?
  situacao     String?
  abertura     DateTime?

  logradouro String?
  numero     String?
  bairro     String?
  cidade     String?
  uf         String?
  cep        String?

  responsavel String
  email       String
  whatsapp    String

  status   StatusRevenda @default(PENDENTE)
  faixa    String?
  detalhe  String?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([status, criadoEm])
  @@schema("vibravert")
}

enum StatusRevenda {
  PENDENTE
  APROVADO
  RECUSADO

  @@schema("vibravert")
}
